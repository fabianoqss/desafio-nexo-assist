{
  "name": "@nexo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts src/migrate.ts src/seed/run-seed.ts --bundle --platform=node --format=esm --target=node26 --outdir=dist --outbase=src --external:pg-native --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/migrate.ts",
    "db:seed": "node src/seed/run-seed.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@hono/zod-validator": "0.9.1",
    "@nexo/contracts": "workspace:*",
    "@nexo/domain": "workspace:*",
    "@nexo/seed-data": "workspace:*",
    "@nexo/server-kit": "workspace:*",
    "cockatiel": "4.0.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.20",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2"
  }
}
